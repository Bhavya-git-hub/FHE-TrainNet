.venv/
__pycache__/
*.py[cod]

# Key material must never be committed (Master Prompt 20).
keys/
*.key
*.sk
*.secret
secret_context*

# Generated experiment output. Regenerate with scripts/run_experiment.py.
results/*
!results/.gitkeep
reports/*
!reports/.gitkeep
.pytest_cache/

# Scratch files from debugging sessions.
*_tmp.py
